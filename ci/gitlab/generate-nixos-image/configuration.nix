# This contains the minimal configuration for a NixOS image with a few additions for:
# - Compatibility with all clusters (kernel modules and drivers)
# - Compatibility with the postinstall customizations (Network, kernel params and filesystems, ssh access)
# - Compatibility with our network stack (DHCP, IPv6)
#
# Some non obvious standard alternatives are provided with a "Standard NixOS:" comment
# The parts that are not standard are preceded by a "Workaround G5K:"
{
  pkgs,
  lib,
  ...
}: let
  version = "$GENERATED_ENV_VERSION";
  commitSha = "$CI_COMMIT_SHA";
  arch = if pkgs.stdenv.hostPlatform.isAarch64 then "arm64" else "x64";
in {

  # The min variant only includes necessary packages
  environment.systemPackages = with pkgs; [
    inetutils # Network utilities, necessary to simplify automated testing with jenkins (to have ping6 available)
    vim
    rsync
    gnupg
  ];

  system.stateVersion = "26.05";

  # Workaround G5K: Ensure compatibility with all clusters
  # Standard NixOS: hardware is defined via a specific hardware-configuration.nix per machine
  hardware.enableAllHardware = true;
  # Workaround G5K: For compatibility with RAID controller like on larochette (mpi3mr), pyxis (mpt3sas) and taurus (megaraid_sas)
  boot.initrd.availableKernelModules = ["mpi3mr" "mpt3sas" "megaraid_sas"];

  services.openssh = {
    enable = true;
  };

  # Workaround G5K: Fix possible timeout on boot waiting for a non-existent TPM device
  boot.initrd.systemd.tpm2.enable = false;
  systemd.tpm2.enable = false;

  time.timeZone = "Europe/Paris";
  boot.loader = {
    # Workaround G5K: Grub is required for kadeploy compatiblity and PXE boot
    # Standard NixOS: You usually have to choose between grub and systemd-boot depending on the hardware
    grub = {
      enable = true;
      device = "nodev";
    };
  };

  # The postinstall will overwrite the "/" to the correct partition depending on the kadeploy arguments
  # Workaround G5K: To simplify the postinstall, we are parsing the fstab generated by the postinstall to generate the correct fileSystems configuration. We also set the default for "/" to fallback to the default PROD partition
  # Standard NixOS: the filesystem is generally described in hardware-configuration.nix using `filesystems = [ ... ];`
  imports = [ ./fstab-parser.nix ];
  fileSystems = {
    "/" = lib.mkDefault {
      device = "/dev/disk/by-partlabel/KDPL_DEPLOY_disk0";
      fsType = "ext4";
    };
  };

  # Workaround G5K: On initial deployment, kadeploy will write the kernel parameters to kadeploy-cmdline.txt
  # Standard NixOS: boot.kernelParams is a static list of strings
  boot.kernelParams = let
    cmdlineFile = ./kadeploy-cmdline.txt;
    rawParams = if builtins.pathExists cmdlineFile
                then builtins.readFile cmdlineFile
                else "";
    paramsList = lib.splitString " " (lib.trim rawParams);
    # Ignore empty parameters and the initial init= parameter
    isWantedParam = x: x != "" && !(lib.hasPrefix "init=" x);
  in
    builtins.filter isWantedParam paramsList;

  # We are using NetworkManager here since we already have a way to customize the connections through the g5k-postinstall
  # Standard NixOS: The default uses dhcpcd which works well with Grid'5000 DHCPv6 and FQDN resolution.
  # Workaround G5K: Using NetworkManager requires a few fixes (see below) regarding DHCPv6 and the FQDN resolution
  # * IPv6: NetworkManager defaults to SLAAC ("auto") and idly waits for Router Advertisements unlike dhcpcd
  # * FQDN: NetworkManager strips the domain name and sets the kernel hostname strictly to the short name
  networking.networkmanager = {
    enable = true;
    connectionConfig = {
      "ipv6.method" = "dhcp"; # Request DHCPv6 even without SLAAC Router Advertisements
      "ipv6.dhcp-duid" = "llt"; # Standard DUID format (Link-layer + time) for Grid'5000 DHCPv6
    };
  };
  # Prioritize DNS resolution so `hostname -f` asks DNS for the canonical FQDN
  system.nssDatabases.hosts = lib.mkForce [
    "mymachines"
    "files"
    "dns"
    "myhostname"
  ];
  # Set the hostname with DHCP
  networking.hostName = "";

  # Workaround G5K: Informative files checked by our automated tests
  environment.etc = {
    "grid5000/release".text = ''
      nixos2605-${arch}-min-${version}
      ${commitSha}
    '';
    "motd".text = ''
      nixos2605-${arch}-min-${version}
      (Image based on NixOS 26.05 for ${arch})
      Maintained by support-staff <support-staff@lists.grid5000.fr>
    '';
  };
  # Standard NixOS: The motd can directly be specfied with `users.motd = "..."`
  # Workaround G5K: Uses the usual path checked by our automated tests
  users.motdFile = "/etc/motd";

  # Workaround G5K: Automatically merges all rules from ./udev_rules into the system udev rules
  # The udev_rules dir is populated during the g5k-postinstall
  # Standard NixOS: It may be simpler to use services.udev.extraRules for a few additions
  services.udev.packages = if builtins.pathExists ./udev_rules then [
    (pkgs.linkFarm "extra-udev-rules" [
      { name = "etc/udev/rules.d"; path = ./udev_rules; }
    ])
  ] else [];
}
